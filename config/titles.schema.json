{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job titles for the internship search",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "exclude_words",
    "titles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "exclude_words": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "titles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "group",
          "aliases",
          "active"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 120
            },
            "uniqueItems": true
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
