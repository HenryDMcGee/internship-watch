{
  "name": "internship-watch-frontend-tests",
  "private": true,
  "description": "Dev and CI tooling for the frontend tests. Nothing here ships in the Worker.",
  "scripts": {
    "test:unit": "jest --coverage",
    "test:ui": "playwright test",
    "coverage:ui": "nyc report --temp-dir .nyc_output --reporter=text --reporter=text-summary && nyc check-coverage --temp-dir .nyc_output --statements 80 --branches 80 --functions 80 --lines 80"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "istanbul-lib-coverage": "3.2.2",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "nyc": "18.0.0",
    "v8-to-istanbul": "9.3.0"
  }
}
